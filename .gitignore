# KiCad lock files and local state
~*.lck
*.kicad_prl
fp-info-cache
*-bak
*.bak

# KiCad / editor backups
*-backups/
_restore_backup_*/
.history/

# Generated boardview (built by CI to GitHub Pages; locally: tools/build_site.py or tools/boardview.py)
_site/
*/boardview/*.html
*/boardview/*.brd
__pycache__/

# Loose photos in the revision folders: the photos each board uses are embedded in its .kicad_pcb
/[0-9]*/*.jpg
/[0-9]*/*.png
